title: "Knowledge-Aware Technician Allocation: The Long-Term Impact of Technician Upskilling (code)"
version: 1.0.0
license: MIT
repository-code: "https://github.com/AdrienBolling/knowledge-aware-technician-assignment"
authors:
  - given-names: Adrien
    family-names: Bolling
    affiliation: "Interdisciplinary Centre for Security, Reliability and Trust (SnT), University of Luxembourg"
  - given-names: Sylvain
    family-names: Kubler
    affiliation: "Interdisciplinary Centre for Security, Reliability and Trust (SnT), University of Luxembourg"
  - given-names: Marcelo Luis
    family-names: Ruiz-Rodríguez
    affiliation: "Interdisciplinary Centre for Security, Reliability and Trust (SnT), University of Luxembourg"
